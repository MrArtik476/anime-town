# Скопируй в .env.local и заполни. .env.local НЕ коммитится.

# --- Сайт ---
# Базовый адрес (canonical, Open Graph). Локально — localhost; продакшен-домен — на этапе «Публикация».
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Только сервер. Никогда не использовать в клиентском коде.
# Нужен для записи переводов в anime_localizations (npm run translate, /api/cron/translate);
# без него перевод не тратит символы (no_store).
SUPABASE_SERVICE_ROLE_KEY=

# --- AniList ---
ANILIST_GRAPHQL_URL=https://graphql.anilist.co

# --- Shikimori (русские названия и описания; ключ не нужен, только сервер) ---
SHIKIMORI_GRAPHQL_URL=https://shikimori.io/api/graphql

# --- Машинный перевод EN→RU (тайтлы без описания на Shikimori) ---
# Провайдер: deepl (позже — yandex). Пусто — перевод выключен, сайт показывает английский оригинал с пометкой.
TRANSLATOR_PROVIDER=
# Ключ DeepL — только сервер: .env.local и секреты Edge Function в Supabase (DEEPL_API_KEY). Free-ключ оканчивается на :fx.
# Можно задать как DEEPL_API_KEY или как общий TRANSLATOR_API_KEY.
DEEPL_API_KEY=
TRANSLATOR_API_KEY=
# Свой потолок расхода символов (по умолчанию 450000 в месяц и 15000 за один запуск).
TRANSLATE_MONTHLY_CHAR_LIMIT=
TRANSLATE_RUN_CHAR_LIMIT=

# --- Ручной запуск перевода через приложение (GET /api/cron/translate, ADR-017) ---
# Случайная строка от 16 символов; передаётся в Authorization: Bearer <CRON_SECRET>.
# Для `npm run translate` не нужна; для Edge Function — секрет Supabase с тем же именем. Пусто — эндпоинт отвечает 401.
CRON_SECRET=

# --- Видео / Storage ---
# Бакет Supabase Storage или внешний CDN с HLS (.m3u8) для лицензированного контента
VIDEO_STORAGE_BUCKET=videos
NEXT_PUBLIC_VIDEO_CDN_URL=

# --- Локальные инструменты разработчика (не нужны ни в CI, ни на хостинге) ---
# Bearer-токен плагина Vault as MCP (Obsidian). Хранить в переменной окружения Windows, не в файлах репозитория.
# OBSIDIAN_MCP_TOKEN=
