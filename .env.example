# Скопируй в .env.local и заполни. .env.local НЕ коммитится.

# --- Сайт ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Только сервер. Никогда не использовать в клиентском коде.
# Нужен для записи переводов в anime_localizations; без него переводы хранятся в памяти процесса.
SUPABASE_SERVICE_ROLE_KEY=

# --- AniList ---
ANILIST_GRAPHQL_URL=https://graphql.anilist.co

# --- Shikimori (русские названия и описания; ключ не нужен, только сервер) ---
SHIKIMORI_GRAPHQL_URL=https://shikimori.io/api/graphql

# --- Машинный перевод EN→RU (тайтлы без описания на Shikimori) ---
# Провайдер ещё не выбран: пока переменные пусты, машинный перевод выключен
# и сайт показывает английский оригинал с пометкой «Русского описания пока нет».
TRANSLATOR_PROVIDER=
# Ключ API переводчика — только сервер, только в .env.local / Vercel.
TRANSLATOR_API_KEY=

# --- Видео / Storage ---
# Бакет Supabase Storage или внешний CDN с HLS (.m3u8) для лицензированного контента
VIDEO_STORAGE_BUCKET=videos
NEXT_PUBLIC_VIDEO_CDN_URL=

# --- Локальные инструменты разработчика (не нужны в Vercel) ---
# Bearer-токен плагина Vault as MCP (Obsidian). Хранить в переменной окружения Windows, не в файлах репозитория.
# OBSIDIAN_MCP_TOKEN=
